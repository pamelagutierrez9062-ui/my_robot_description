<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- MATERIALES -->
  <material name="industrial_grey"><color rgba="0.45 0.47 0.50 1.0"/></material>
  <material name="metal_dark"><color rgba="0.22 0.24 0.27 1.0"/></material>
  <material name="accent_red"><color rgba="0.85 0.15 0.15 1.0"/></material>
  <material name="chrome_details"><color rgba="0.75 0.78 0.82 1.0"/></material>
  <material name="gripper_rubber"><color rgba="0.10 0.10 0.12 1.0"/></material>

  <!-- BASE ESTRUCTURAL -->
  <link name="base_link">
    <visual><origin xyz="0 0 0.005"/><geometry><box size="0.26 0.26 0.01"/></geometry><material name="metal_dark"/></visual>
    <visual><origin xyz="0.11 0.11 0.012"/><geometry><cylinder radius="0.008" length="0.015"/></geometry><material name="chrome_details"/></visual>
    <visual><origin xyz="-0.11 0.11 0.012"/><geometry><cylinder radius="0.008" length="0.015"/></geometry><material name="chrome_details"/></visual>
    <visual><origin xyz="0.11 -0.11 0.012"/><geometry><cylinder radius="0.008" length="0.015"/></geometry><material name="chrome_details"/></visual>
    <visual><origin xyz="-0.11 -0.11 0.012"/><geometry><cylinder radius="0.008" length="0.015"/></geometry><material name="chrome_details"/></visual>
    <collision><geometry><box size="0.26 0.26 0.02"/></geometry></collision>
    <inertial><mass value="5.0"/><origin xyz="0 0 0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>

  <joint name="joint_base_structure" type="fixed">
    <parent link="base_link"/>
    <child link="base_top_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <link name="base_top_link">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.24 0.24 0.012"/></geometry><material name="industrial_grey"/></visual>
    <visual><origin xyz="0.09 0.09 -0.045"/><geometry><cylinder radius="0.006" length="0.078"/></geometry><material name="chrome_details"/></visual>
    <visual><origin xyz="-0.09 0.09 -0.045"/><geometry><cylinder radius="0.006" length="0.078"/></geometry><material name="chrome_details"/></visual>
    <visual><origin xyz="0.09 -0.09 -0.045"/><geometry><cylinder radius="0.006" length="0.078"/></geometry><material name="chrome_details"/></visual>
    <visual><origin xyz="-0.09 -0.09 -0.045"/><geometry><cylinder radius="0.006" length="0.078"/></geometry><material name="chrome_details"/></visual>
    <visual><origin xyz="0 0 -0.045"/><geometry><cylinder radius="0.030" length="0.075"/></geometry><material name="metal_dark"/></visual>
    <collision><geometry><box size="0.24 0.24 0.012"/></geometry></collision>
    <inertial><mass value="2.0"/><origin xyz="0 0 0"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
  </link>

  <!-- JOINT 1: CINTURA GIRO -->
  <joint name="joint_1" type="revolute">
    <parent link="base_top_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.01" rpy="0 0 0.5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100.0" velocity="1.0"/>
    <dynamics damping="5.0" friction="2.0"/>
  </joint>

  <link name="link_1">
    <visual><origin xyz="0 0 0.005"/><geometry><cylinder radius="0.07" length="0.01"/></geometry><material name="metal_dark"/></visual>
    <visual><origin xyz="0 0 0.045"/><geometry><cylinder radius="0.05" length="0.07"/></geometry><material name="industrial_grey"/></visual>
    <visual><origin xyz="0 0 0.08"/><geometry><cylinder radius="0.052" length="0.005"/></geometry><material name="chrome_details"/></visual>
    <collision><geometry><cylinder radius="0.07" length="0.1"/></geometry></collision>
    <inertial><mass value="1.5"/><origin xyz="0 0 0.05"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial>
  </link>

  <!-- CODO 1 (BASE/HOMBRO): CILÍNDRICO MÁS PEQUEÑO (radius 0.022) -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.09" rpy="0 0.55 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100.0" velocity="1.0"/>
    <dynamics damping="10.0" friction="5.0"/>
  </joint>

  <link name="link_2">
    <!-- Codo 1 cilíndrico estilizado -->
    <visual><origin xyz="0 0 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.022" length="0.055"/></geometry><material name="metal_dark"/></visual>
    <visual><origin xyz="0 0.029 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.023" length="0.003"/></geometry><material name="chrome_details"/></visual>
    <visual><origin xyz="0 -0.029 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.023" length="0.003"/></geometry><material name="chrome_details"/></visual>
    
    <!-- Primer palo cilíndrico -->
    <visual><origin xyz="0 0 0.11"/><geometry><cylinder radius="0.018" length="0.22"/></geometry><material name="industrial_grey"/></visual>
    <visual><origin xyz="0 0.020 0.11"/><geometry><cylinder radius="0.004" length="0.18"/></geometry><material name="chrome_details"/></visual>
    <visual><origin xyz="0 -0.020 0.11"/><geometry><cylinder radius="0.004" length="0.18"/></geometry><material name="chrome_details"/></visual>
    <collision><geometry><cylinder radius="0.025" length="0.23"/></geometry></collision>
    <inertial><mass value="1.0"/><origin xyz="0 0 0.11"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/></inertial>
  </link>

  <!-- CODO 2 (CENTRAL ROJO): CILÍNDRICO MÁS PEQUEÑO (radius 0.020) -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.22" rpy="0 0.80 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="100.0" velocity="1.0"/>
    <dynamics damping="8.0" friction="4.0"/>
  </joint>

  <link name="link_3">
    <!-- Codo 2 rojo compacto -->
    <visual><origin xyz="0 0 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.020" length="0.055"/></geometry><material name="accent_red"/></visual>
    <visual><origin xyz="0 0.029 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.021" length="0.003"/></geometry><material name="chrome_details"/></visual>
    <visual><origin xyz="0 -0.029 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.021" length="0.003"/></geometry><material name="chrome_details"/></visual>

    <!-- Segundo palo cilíndrico rojo -->
    <visual><origin xyz="0 0 0.10"/><geometry><cylinder radius="0.015" length="0.20"/></geometry><material name="accent_red"/></visual>
    <collision><geometry><cylinder radius="0.018" length="0.20"/></geometry></collision>
    <inertial><mass value="0.8"/><origin xyz="0 0 0.10"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
  </link>

  <!-- CODO 3 (MINI CODO EN LA MANO) + MUÑECA APUNTANDO A 90° HACIA ABAJO -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="effector_link"/>
    <origin xyz="0 0 0.20" rpy="0 1.35 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>

  <link name="effector_link">
    <!-- Mini Codo 3 cilíndrico metálico en la muñeca -->
    <visual><origin xyz="0 0 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.015" length="0.040"/></geometry><material name="chrome_details"/></visual>
    <visual><origin xyz="0 0.021 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.016" length="0.002"/></geometry><material name="metal_dark"/></visual>
    <visual><origin xyz="0 -0.021 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.016" length="0.002"/></geometry><material name="metal_dark"/></visual>

    <!-- Base y Actuador Piston de la mano -->
    <visual><origin xyz="0 0 0.015"/><geometry><cylinder radius="0.012" length="0.018"/></geometry><material name="metal_dark"/></visual>
    <visual><origin xyz="0 0 0.028"/><geometry><box size="0.022 0.048 0.010"/></geometry><material name="industrial_grey"/></visual>
    <visual><origin xyz="0 0 0.035"/><geometry><cylinder radius="0.004" length="0.015"/></geometry><material name="chrome_details"/></visual>

    <!-- DEDOS APUNTANDO DIRECCIÓN PISO (VERTICAL HACIA ABAJO) -->
    <visual><origin xyz="0 0.020 0.045" rpy="0.10 0 0"/><geometry><box size="0.008 0.006 0.020"/></geometry><material name="industrial_grey"/></visual>
    <visual><origin xyz="0 0.021 0.062" rpy="-0.20 0 0"/><geometry><box size="0.007 0.005 0.018"/></geometry><material name="industrial_grey"/></visual>
    <visual><origin xyz="0 0.018 0.072"/><geometry><box size="0.009 0.004 0.008"/></geometry><material name="gripper_rubber"/></visual>

    <visual><origin xyz="0 -0.020 0.045" rpy="-0.10 0 0"/><geometry><box size="0.008 0.006 0.020"/></geometry><material name="industrial_grey"/></visual>
    <visual><origin xyz="0 -0.021 0.062" rpy="0.20 0 0"/><geometry><box size="0.007 0.005 0.018"/></geometry><material name="industrial_grey"/></visual>
    <visual><origin xyz="0 -0.018 0.072"/><geometry><box size="0.009 0.004 0.008"/></geometry><material name="gripper_rubber"/></visual>

    <collision><geometry><box size="0.06 0.06 0.08"/></geometry></collision>
    <inertial><mass value="0.20"/><origin xyz="0 0 0.04"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <!-- GAZEBO PBR MATERIALS -->
  <gazebo reference="base_link"><visual><material><ambient>0.22 0.24 0.27 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse><metalness>0.7</metalness><roughness>0.3</roughness></material></visual></gazebo>
  <gazebo reference="base_top_link"><visual><material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse><metalness>0.5</metalness><roughness>0.4</roughness></material></visual></gazebo>
  <gazebo reference="link_1"><visual><material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse><metalness>0.6</metalness><roughness>0.3</roughness></material></visual></gazebo>
  <gazebo reference="link_2"><visual><material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse><metalness>0.5</metalness><roughness>0.4</roughness></material></visual></gazebo>
  <gazebo reference="link_3"><visual><material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse><metalness>0.3</metalness><roughness>0.2</roughness></material></visual></gazebo>
  <gazebo reference="effector_link"><visual><material><ambient>0.22 0.24 0.27 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse><metalness>0.8</metalness><roughness>0.2</roughness></material></visual></gazebo>
</robot>
